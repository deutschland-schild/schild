{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.schild.invalid/v0/host-report.schema.json",
  "title": "Host report schild.host_report/0.1 (v0.3, MVP-11)",
  "description": "One report per host and run of `schild check` (gateway) or `schild agent` (app VM). Read-only findings and a software inventory. Stays in the operator network: never a signal, never sent to a lab. No secrets: no file contents, no environment variables, no private keys (host-check.md section 2). Hostnames and local addresses are allowed (local only). At most 512 KiB, 500 findings and 2000 inventory items.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "report_id", "host", "run", "findings", "inventory"],
  "properties": {
    "schema": { "const": "schild.host_report/0.1" },
    "report_id": { "$ref": "common.schema.json#/$defs/uuid" },
    "host": { "$ref": "#/$defs/host" },
    "run": { "$ref": "#/$defs/run" },
    "findings": {
      "description": "One entry per check result. (id, subject) is unique.",
      "type": "array",
      "maxItems": 500,
      "items": { "$ref": "#/$defs/finding" }
    },
    "inventory": {
      "description": "Packages, runtimes, servers, databases and apps relevant for advisories (not every installed package).",
      "type": "array",
      "maxItems": 2000,
      "items": { "$ref": "#/$defs/inventoryItem" }
    }
  },
  "$defs": {
    "text": {
      "description": "One line of text (German UI copy), no control characters.",
      "type": "string",
      "pattern": "^[^\\x00-\\x1f\\x7f]*$"
    },
    "date": {
      "description": "Calendar date YYYY-MM-DD (EOL dates).",
      "type": "string",
      "pattern": "^20[0-9]{2}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$"
    },
    "nullableDate": {
      "oneOf": [{ "$ref": "#/$defs/date" }, { "type": "null" }]
    },
    "hostname": {
      "description": "Lower-case host name as configured on the host (local only).",
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.-]{0,252}$"
    },
    "absPath": {
      "description": "Absolute path of a file or directory that was read. Only the path, never the content.",
      "type": "string",
      "pattern": "^/[A-Za-z0-9._/@+-]{0,255}$"
    },
    "token": {
      "description": "A single value token: no spaces, no '=' (so no assignments and no environment dumps).",
      "type": "string",
      "pattern": "^[A-Za-z0-9._:/@+,-]{0,128}$"
    },
    "packageName": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.+_:@/-]{0,127}$"
    },
    "version": {
      "type": "string",
      "pattern": "^[A-Za-z0-9.+~:_-]{1,128}$"
    },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hostname", "role", "agent_key_id", "os"],
      "properties": {
        "hostname": { "$ref": "#/$defs/hostname" },
        "role": { "type": "string", "enum": ["gateway", "agent"] },
        "agent_key_id": {
          "description": "Key id of the agent that signs the delivery (role agent); null on the gateway.",
          "oneOf": [{ "$ref": "common.schema.json#/$defs/keyid" }, { "type": "null" }]
        },
        "os": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "version_id", "name", "kernel", "arch", "eol"],
          "properties": {
            "id": { "description": "ID from /etc/os-release (debian, ubuntu, rocky, almalinux, ...).", "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,31}$" },
            "version_id": { "description": "VERSION_ID from /etc/os-release; empty for rolling releases.", "type": "string", "pattern": "^[A-Za-z0-9._-]{0,32}$" },
            "name": { "description": "PRETTY_NAME from /etc/os-release.", "allOf": [{ "$ref": "#/$defs/text" }], "minLength": 1, "maxLength": 128 },
            "kernel": { "description": "Running kernel (uname -r).", "type": "string", "pattern": "^[A-Za-z0-9._+~-]{1,64}$" },
            "arch": { "description": "uname -m.", "type": "string", "pattern": "^[a-z0-9_]{1,16}$" },
            "eol": { "description": "End of regular support from the bundled EOL table; null if unknown.", "$ref": "#/$defs/nullableDate" },
            "extended_support_until": { "description": "End of extended support (ESM, ELTS) if known.", "$ref": "#/$defs/nullableDate" }
          }
        }
      },
      "if": { "properties": { "role": { "const": "agent" } } },
      "then": { "properties": { "agent_key_id": { "$ref": "common.schema.json#/$defs/keyid" } } },
      "else": { "properties": { "agent_key_id": { "type": "null" } } }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["started_at", "duration_ms", "schild_version", "eol_table", "as_root"],
      "properties": {
        "started_at": { "$ref": "common.schema.json#/$defs/timestamp" },
        "duration_ms": { "type": "integer", "minimum": 0, "maximum": 3600000 },
        "schild_version": { "type": "string", "pattern": "^[A-Za-z0-9.+_-]{1,64}$" },
        "eol_table": { "description": "Date of the bundled EOL table (offline, no lookup at runtime).", "$ref": "#/$defs/date" },
        "as_root": { "description": "The check ran as root (false: unprivileged with the groups and capabilities of host-check.md section 4).", "type": "boolean" }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "area", "severity", "status", "title", "explanation", "fix_command", "evidence"],
      "properties": {
        "id": { "description": "Stable check id, e.g. ssh.password_authentication. Never changes meaning.", "type": "string", "pattern": "^[a-z][a-z0-9_]{0,31}(\\.[a-z0-9_]{1,48}){1,3}$" },
        "area": { "description": "logs since v0.5 (D38, MVP-11 addendum Log-Hygiene).", "type": "string", "enum": ["distribution", "updates", "ports", "firewall", "ssh", "tls", "software", "logs"] },
        "subject": { "description": "What the finding is about when one check yields several (tcp/3306, a site name, a package).", "type": "string", "pattern": "^[A-Za-z0-9._:/@+-]{1,128}$" },
        "severity": { "type": "string", "enum": ["info", "low", "medium", "high", "critical"] },
        "status": { "type": "string", "enum": ["ok", "finding", "unreadable"] },
        "title": { "description": "German, short, calm.", "allOf": [{ "$ref": "#/$defs/text" }], "minLength": 1, "maxLength": 160 },
        "explanation": { "description": "German: what it means and why it matters.", "allOf": [{ "$ref": "#/$defs/text" }], "minLength": 1, "maxLength": 1000 },
        "fix_command": {
          "description": "Copyable command (one line) that fixes the finding; null when there is none.",
          "oneOf": [{ "allOf": [{ "$ref": "#/$defs/text" }], "minLength": 1, "maxLength": 1000 }, { "type": "null" }]
        },
        "fix_config": { "$ref": "#/$defs/fixConfig" },
        "evidence": { "$ref": "#/$defs/evidence" },
        "unreadable": { "$ref": "#/$defs/unreadable" }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "unreadable" } } },
          "then": { "required": ["unreadable"], "properties": { "severity": { "const": "info" } } },
          "else": { "not": { "required": ["unreadable"] } }
        },
        {
          "if": { "properties": { "status": { "const": "ok" } } },
          "then": { "properties": { "severity": { "const": "info" } } }
        },
        {
          "if": { "properties": { "status": { "const": "finding" } } },
          "else": { "not": { "required": ["fix_config"] } }
        }
      ]
    },
    "evidence": {
      "description": "Small typed facts only, never free text or file contents. Values of secret-bearing settings are never reported.",
      "type": "object",
      "additionalProperties": false,
      "maxProperties": 12,
      "properties": {
        "source": {
          "type": "string",
          "enum": ["os_release", "uname", "eol_table", "apt", "dnf", "yum", "dpkg", "rpm", "unattended_upgrades", "dnf_automatic", "reboot_required", "needs_restarting", "ss", "proc_net", "nft", "iptables", "ufw", "firewalld", "sshd_t", "sshd_config", "journal", "auth_log", "cert_store", "tls_handshake", "binary", "app_path", "systemd", "docker_daemon", "docker_container", "journald_conf", "logrotate_conf", "logrotate_status", "stat", "caddyfile"]
        },
        "path": { "$ref": "#/$defs/absPath" },
        "setting": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$" },
        "value": { "$ref": "#/$defs/token" },
        "expected": { "$ref": "#/$defs/token" },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "protocol": { "type": "string", "enum": ["tcp", "udp"] },
        "address": { "description": "Local listen address (IPv4, IPv6 or *).", "type": "string", "pattern": "^([0-9a-f:.]{2,45}|\\*)$" },
        "process": { "type": "string", "pattern": "^[A-Za-z0-9._+-]{1,64}$" },
        "package": { "$ref": "#/$defs/packageName" },
        "installed_version": { "$ref": "#/$defs/version" },
        "candidate_version": { "$ref": "#/$defs/version" },
        "count": { "type": "integer", "minimum": 0, "maximum": 1000000000 },
        "packages": { "type": "array", "maxItems": 50, "items": { "$ref": "#/$defs/packageName" } },
        "date": { "$ref": "#/$defs/date" },
        "not_after": { "$ref": "common.schema.json#/$defs/timestamp" },
        "days_left": { "type": "integer", "minimum": -36500, "maximum": 36500 },
        "enabled": { "type": "boolean" },
        "policy": { "type": "string", "enum": ["accept", "drop", "reject", "unknown"] },
        "window_hours": { "type": "integer", "minimum": 1, "maximum": 168 },
        "size_bytes": { "description": "v0.5 (D38): size of a file or directory from st_blocks (sparse files count what they occupy).", "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "growth_bytes_per_day": { "description": "v0.5 (D38): growth since the previous kept report, per day (negative: it shrank).", "type": "integer", "minimum": -9007199254740991, "maximum": 9007199254740991 },
        "fs_percent": { "description": "v0.5 (D38): share of the file system it occupies, whole percent.", "type": "integer", "minimum": 0, "maximum": 100 },
        "mount": { "description": "v0.5 (D38): mount point of the file system.", "$ref": "#/$defs/absPath" }
      }
    },
    "fixConfig": {
      "description": "v0.5 (D38): a config file that fixes the finding, offered next to or instead of fix_command (UI: path, content, copy button). path and content must be a rendering of a gateway-side template of the finding id whose only variable parts are checked paths, slugs and numbers (host-check.md section 2, hostcheck.FixTemplates); anything else is rejected (schema). Only with status finding.",
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "content"],
      "properties": {
        "path": { "$ref": "#/$defs/absPath" },
        "content": { "description": "Full file content, lines separated by LF; no other control characters.", "type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^[^\\x00-\\x09\\x0b-\\x1f\\x7f]*$" }
      }
    },
    "unreadable": {
      "description": "Why a check could not read safely (\"nicht lesbar\") and what it would need.",
      "type": "object",
      "additionalProperties": false,
      "required": ["reason"],
      "properties": {
        "reason": { "type": "string", "enum": ["permission_denied", "not_installed", "not_supported", "not_configured", "timeout", "parse_error"] },
        "needs": { "description": "root, a capability (CAP_NET_ADMIN) or a group (group:adm).", "type": "string", "pattern": "^(root|CAP_[A-Z_]{2,32}|group:[a-z_][a-z0-9_-]{0,31})$" }
      }
    },
    "inventoryItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "name", "version", "eol", "source"],
      "properties": {
        "kind": { "type": "string", "enum": ["os_package", "runtime", "server", "database", "app"] },
        "name": { "$ref": "#/$defs/packageName" },
        "version": { "$ref": "#/$defs/version" },
        "eol": { "description": "End of support from the bundled EOL table; null if unknown.", "$ref": "#/$defs/nullableDate" },
        "source": { "type": "string", "enum": ["dpkg", "rpm", "apk", "binary", "app_path"] },
        "path": { "description": "Apps only: the configured path the app was detected in.", "$ref": "#/$defs/absPath" },
        "parent": { "description": "Plugins and extensions: the app they belong to (wordpress, typo3, nextcloud).", "$ref": "#/$defs/packageName" }
      }
    }
  }
}

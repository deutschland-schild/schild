  },
  "input_raw": "{\"blocks\":[{\"addresses\":[\"www.example.org\"],\"proxies\":true,\"schild\":true},{\"addresses\":[\"example.org\",\"www.example.org\"],\"proxies\":true,\"schild\":true}],\"mode\":\"ingress\"}",
  "input_decoded": {
    "blocks": [
      {
        "addresses": [
          "www.example.org"
        ],
        "proxies": true,
        "schild": true
      },
      {
        "addresses": [
          "example.org",
          "www.example.org"
        ],
        "proxies": true,
        "schild": true
      }
    ],
    "mode": "ingress"
  },
  "expect": {
    "valid": true,

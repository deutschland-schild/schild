{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.schild.invalid/v0/envelope.schema.json",
  "title": "DSSE envelope (Schild profile)",
  "description": "DSSE v1 envelope with Ed25519 signatures. Standard base64 with padding, canonical encoding only. See envelope.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["payloadType", "payload", "signatures"],
  "properties": {
    "payloadType": {
      "type": "string",
      "pattern": "^application/vnd\\.schild\\.[a-z][a-z-]{0,30}\\.v[0-9]{1,3}\\+json$"
    },
    "payload": {
      "type": "string",
      "minLength": 4,
      "maxLength": 1048576,
      "pattern": "^([A-Za-z0-9+/]{4})*([A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
    },
    "signatures": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["keyid", "sig"],
        "properties": {
          "keyid": { "$ref": "common.schema.json#/$defs/keyid" },
          "sig": {
            "description": "Ed25519 signature over PAE(payloadType, payload): 64 bytes.",
            "type": "string",
            "pattern": "^[A-Za-z0-9+/]{85}[AQgw]==$"
          }
        }
      }
    }
  }
}

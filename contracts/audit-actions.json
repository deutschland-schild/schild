{
  "schema": "schild.audit_actions/0.1",
  "actions": [
    { "action": "access_lock.set", "class": "change", "subject": "website", "website": "required", "operations": ["dashboard:setAccessProtection", "cli:lock on"], "fields": ["/scope", "/paths", "/except", "/addresses", "/own_networks", "/message", "/password"], "addresses": ["/addresses"] },
    { "action": "access_lock.remove", "class": "change", "subject": "website", "website": "required", "operations": ["dashboard:removeAccessProtection", "cli:lock off"], "fields": ["/scope", "/paths", "/except", "/addresses", "/own_networks", "/message", "/password"], "addresses": ["/addresses"] },
    { "action": "maintenance.set", "class": "change", "subject": "website", "website": "required", "operations": ["dashboard:setMaintenance", "cli:lock off"], "fields": ["/on", "/message"] },
    { "action": "crawlers.set", "class": "change", "subject": "website", "website": "required", "operations": ["dashboard:setCrawlerPolicy", "agent:setAgentCrawlers"], "fields": ["/categories/*", "/bots/*", "/impersonators", "/preset"] },
    { "action": "human_check.set", "class": "change", "subject": "website", "website": "required", "operations": ["dashboard:setHumanCheck"], "fields": ["/mode", "/under_attack/*", "/except", "/clearance_ttl_s", "/difficulty"] },
    { "action": "human_check.remove", "class": "change", "subject": "website", "website": "required", "operations": ["dashboard:removeHumanCheck"], "fields": ["/mode", "/under_attack/*", "/except", "/clearance_ttl_s", "/difficulty"] },
    { "action": "block.set", "class": "change", "subject": "block", "website": "optional", "portal": true, "operations": ["dashboard:createBlock", "agent:createAgentBlock"], "fields": ["/client", "/duration_s", "/until", "/effect"], "addresses": ["/client"] },
    { "action": "block.lift", "class": "change", "subject": "block", "website": "optional", "portal": true, "operations": ["dashboard:unblockIncident", "dashboard:releaseClient", "agent:liftAgentBlock"], "fields": ["/client", "/until", "/false_positive"], "addresses": ["/client"] },
    { "action": "client.release", "class": "change", "subject": "client", "website": "optional", "portal": true, "operations": ["dashboard:releaseClient", "dashboard:unblockIncident"], "fields": ["/client", "/scenario", "/limit_id", "/allow", "/until"], "addresses": ["/client"] },
    { "action": "wave.end", "class": "change", "subject": "wave", "website": "optional", "operations": ["dashboard:endWave"], "fields": ["/state"] },
    { "action": "allowlist.add", "class": "change", "subject": "allowlist_entry", "website": "optional", "portal": true, "operations": ["dashboard:addAllowlistEntry", "dashboard:allowMyIP", "dashboard:unblockIncident", "dashboard:releaseClient", "cli:allow"], "fields": ["/ip", "/cidr", "/host", "/label", "/level", "/expires"], "addresses": ["/ip", "/cidr"] },
    { "action": "allowlist.remove", "class": "change", "subject": "allowlist_entry", "website": "optional", "portal": true, "operations": ["dashboard:deleteAllowlistEntry", "cli:allow rm", "system:expiry"], "fields": ["/ip", "/cidr", "/host", "/label", "/level", "/expires"], "addresses": ["/ip", "/cidr"] },
    { "action": "rule_exception.set", "class": "change", "subject": "rule_exception", "website": "required", "portal": true, "operations": ["dashboard:createRuleException", "agent:createAgentException"], "fields": ["/path", "/target", "/repository", "/rules"] },
    { "action": "rule_exception.remove", "class": "change", "subject": "rule_exception", "website": "required", "portal": true, "operations": ["dashboard:removeRuleException", "dashboard:removeRuleExceptionRule", "agent:removeAgentException"], "fields": ["/path", "/target", "/repository", "/rules"] },
    { "action": "rule.set", "class": "change", "subject": "rule", "website": "none", "operations": ["dashboard:updateRule", "agent:updateAgentRule"], "fields": ["/disabled"] },
    { "action": "rule_repository.set", "class": "change", "subject": "rule_repository", "website": "none", "operations": ["dashboard:updateRuleRepository", "dashboard:updateRuleRepositorySettings", "agent:updateAgentRuleRepository"], "fields": ["/state", "/paranoia_level", "/inbound_anomaly_threshold"] },
    { "action": "rule_repository.sync", "class": "change", "subject": "rule_repository", "website": "none", "operations": ["dashboard:syncRuleRepository", "agent:syncAgentRuleRepository", "cli:rules sync", "system:hub_update", "system:sighup"], "fields": ["/set", "/rules_loaded"] },
    { "action": "rule_repository.reset", "class": "change", "subject": "rule_repository", "website": "none", "operations": ["dashboard:resetRuleRepository", "agent:resetAgentRuleRepository", "cli:rules reset"], "fields": ["/set", "/rules_loaded"] },
    { "action": "behaviour.set", "class": "change", "subject": "setting", "website": "none", "operations": ["dashboard:updateBehaviourSettings"], "fields": ["/scenarios/*", "/thresholds/*/*", "/preset_limit_modes/*"] },
    { "action": "distributed.set", "class": "change", "subject": "setting", "website": "none", "operations": ["dashboard:updateDistributedSettings"], "fields": ["/detectors/*", "/thresholds/*/*"] },
    { "action": "rate_limit.add", "class": "change", "subject": "rate_limit", "website": "optional", "operations": ["dashboard:createRateLimit"], "fields": ["/route", "/methods", "/limit", "/per", "/burst", "/mode", "/site", "/label"] },
    { "action": "rate_limit.update", "class": "change", "subject": "rate_limit", "website": "optional", "operations": ["dashboard:updateRateLimit"], "fields": ["/route", "/methods", "/limit", "/per", "/burst", "/mode", "/site", "/label"] },
    { "action": "rate_limit.remove", "class": "change", "subject": "rate_limit", "website": "optional", "operations": ["dashboard:deleteRateLimit"], "fields": ["/route", "/methods", "/limit", "/per", "/burst", "/mode", "/site", "/label"] },
    { "action": "settings.set", "class": "change", "subject": "setting", "website": "none", "operations": ["dashboard:updateSettings"], "fields": ["/retention/*"] },
    { "action": "agent_api.set", "class": "change", "subject": "setting", "website": "none", "operations": ["dashboard:setAgentAPI"], "fields": ["/enabled", "/source"] },
    { "action": "host_finding.accept", "class": "change", "subject": "host_finding", "website": "none", "operations": ["dashboard:acceptHostFinding"], "fields": ["/host", "/finding", "/object"] },
    { "action": "host_finding.reopen", "class": "change", "subject": "host_finding", "website": "none", "operations": ["dashboard:reopenHostFinding"], "fields": ["/host", "/finding", "/object"] },
    { "action": "config.apply", "class": "change", "subject": "config", "website": "none", "operations": ["config:schild_yaml", "config:caddyfile"], "fields": ["/digest"] },
    { "action": "cluster.join", "class": "change", "subject": "node", "website": "none", "operations": ["system:cluster"], "fields": ["/name", "/version"] },
    { "action": "cluster.remove", "class": "change", "subject": "node", "website": "none", "operations": ["cli:cluster remove"], "fields": ["/name"] },
    { "action": "cluster.drain", "class": "change", "subject": "node", "website": "none", "operations": ["cli:cluster drain"], "fields": [] },
    { "action": "audit.start", "class": "change", "subject": "audit", "website": "none", "operations": ["system:start"], "fields": ["/reason"] },

    { "action": "password.setup", "class": "credential", "subject": "user", "website": "none", "operations": ["dashboard:setupPassword"], "fields": ["/password"] },
    { "action": "password.change", "class": "credential", "subject": "user", "website": "none", "operations": ["dashboard:changePassword"], "fields": ["/password"] },
    { "action": "password.setup_code_shown", "class": "credential", "subject": "user", "website": "none", "operations": ["cli:dashboard setup-code"], "fields": [] },
    { "action": "password.reset", "class": "credential", "subject": "user", "website": "none", "operations": ["cli:dashboard reset-password"], "fields": ["/users", "/sessions"] },
    { "action": "token.add", "class": "credential", "subject": "token", "website": "none", "operations": ["cli:token add"], "fields": ["/scope", "/label", "/expires"] },
    { "action": "token.revoke", "class": "credential", "subject": "token", "website": "none", "operations": ["cli:token revoke"], "fields": ["/scope", "/label", "/expires"] },
    { "action": "token.expire", "class": "credential", "subject": "token", "website": "none", "operations": ["system:expiry"], "fields": ["/scope", "/label", "/expires"] },
    { "action": "host_agent.enrol", "class": "credential", "subject": "host_agent", "website": "none", "operations": ["dashboard:createEnrolment"], "fields": ["/label", "/ttl_minutes"] },
    { "action": "host_agent.confirm", "class": "credential", "subject": "host_agent", "website": "none", "operations": ["dashboard:confirmAgent"], "fields": ["/label", "/fingerprint"] },
    { "action": "host_agent.revoke", "class": "credential", "subject": "host_agent", "website": "none", "operations": ["dashboard:revokeAgent"], "fields": ["/label", "/fingerprint"] },

    { "action": "privacy.export", "class": "privacy", "subject": "address", "website": "none", "operations": ["dashboard:privacyExport"], "fields": ["/events", "/incidents", "/requests"] },
    { "action": "privacy.erase", "class": "privacy", "subject": "address", "website": "none", "operations": ["dashboard:privacyDelete"], "fields": ["/events", "/incidents", "/requests", "/blocks", "/allowlist", "/keep_incidents"] },
    { "action": "incident.export", "class": "privacy", "subject": "incident", "website": "optional", "operations": ["dashboard:exportIncident"], "fields": [] },

    { "action": "session.start", "class": "access", "subject": "user", "website": "none", "operations": ["dashboard:login", "dashboard:setupPassword", "dashboard:changePassword"], "fields": [] },
    { "action": "session.end", "class": "access", "subject": "user", "website": "none", "operations": ["dashboard:logout"], "fields": [] },
    { "action": "agent_api.call", "class": "access", "subject": "agent_api", "website": "none", "refused_only": true, "operations": ["agent:any"], "fields": [] }
  ],
  "not_audited": [
    { "operation": "dashboard:runLocalCheck", "reason": "Reads the host and changes nothing but its report." },
    { "operation": "dashboard:dryRunRateLimit", "reason": "Counts, changes nothing." },
    { "operation": "agent:testAgentRequest", "reason": "Tests, changes nothing; in the call log." },
    { "operation": "agent:syncAgentFirewall", "reason": "Reports what the host firewall holds, every few seconds; in the call log." },
    { "operation": "cli:init", "reason": "Writes files before there is a gateway; the first start records config.apply." },
    { "operation": "cli:cluster secret", "reason": "Prints a new secret and stores nothing." },
    { "operation": "cli:firewall run", "reason": "Keeps the host firewall in line with the gateway's blocks, often on a machine or in a container without the store; every block has its own entry." },
    { "operation": "cli:firewall off", "reason": "Changes the host firewall, often on a machine or in a container without the store; the gateway's blocks stay." },
    { "operation": "cli:check", "reason": "Reads the host and writes its report, nothing of the gateway." },
    { "operation": "cli:geo-fixture", "reason": "Writes a test database of documentation ranges into a file, nothing of the gateway." },
    { "operation": "cli:check install", "reason": "Sets up systemd units of the host, not the gateway." },
    { "operation": "cli:check uninstall", "reason": "Removes systemd units of the host, not the gateway." }
  ],
  "undocumented": [
    { "operation": "dashboard:setHumanCheck", "route": "PUT /websites/{website}/human-check" },
    { "operation": "dashboard:removeHumanCheck", "route": "DELETE /websites/{website}/human-check" }
  ]
}

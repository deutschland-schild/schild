node_modules
.nuxt
.output
.data
dist
.env
.DS_Store

# Private notes of a checkout, never part of this repo (no trailing slash: it may be a symlink).
/docs/internal

# Agent worktrees (Claude Code isolation)
/.claude/worktrees/

# ------------------------------------------------------------------ Go, contracts, dashboards, test lab
# Build output
/bin/
*.test
*.out
# ...but the recorded command outputs of the host check fixtures are test data
!gateway/internal/hostcheck/testdata/hosts/*/cmd/*.out
coverage.*

# Python helper venv for the contract cross-check
/.venv/
__pycache__/

# Local measurement scratch (tests/results/<spec>.json itself is kept)
/tests/results/runs/
/tests/results/tmp/

# Contract cross-check scratch
/contracts/.check/

# Dashboard build copies (produced by `make ui`, embedded via go:embed)
# (dist/.gitkeep stays so `//go:embed all:dist` always compiles)
# (`dist` is ignored above, so re-include these two dirs first)
!/gateway/internal/webui/dist/
/gateway/internal/webui/dist/*
!/gateway/internal/webui/dist/.gitkeep
!/lab/internal/webui/dist/
/lab/internal/webui/dist/*
!/lab/internal/webui/dist/.gitkeep

# Real private keys never go into git (test keys live in contracts/testkeys/keys.json)
*.key

# Test lab secrets (TEST ONLY keys, test CA, geo fixture): make testlab-secrets
/tests/testlab/compose/secrets/

# UX screenshots (regenerated by dashboard/scripts/ux-shots.mjs)
/tests/results/ux/
# binaries of a plain go build in a module folder
/lab/schild-lab
/relay/schild-relay
/gateway/schild
/gateway/schild-agent

# Built measuring tools
tests/testlab/measure/monitoring/measure
tests/testlab/measure/**/hostile/hostile
tests/testlab/measure/**/tool/tool

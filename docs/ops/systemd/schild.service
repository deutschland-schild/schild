# schild (Schild Gateway) as a systemd service. Shipped in the release tarball
# schild_<version>_linux_<arch>.tar.gz next to the binary.
#
# Install:
#   sudo install -m 0755 schild /usr/local/bin/schild
#   sudo install -m 0644 schild.service /etc/systemd/system/schild.service
#   sudo useradd --system --home-dir /var/lib/schild --create-home --shell /usr/sbin/nologin schild
# then write /etc/schild/schild.yaml, one of:
#   sudo schild init -caddyfile /etc/caddy/Caddyfile   (schild runs as your Caddy; prints the next steps)
#   sudo schild init -upstream http://127.0.0.1:3000   (schild as a proxy behind your web server)
# and start:
#   sudo systemctl daemon-reload && sudo systemctl enable --now schild
#
# schild runs as the unprivileged user "schild" and writes only below
# /var/lib/schild (events, metrics, Caddy storage, temp files of request
# bodies). It reads /etc/schild (the user schild must be able to read
# schild.yaml) and, if present, the geo data in /usr/share/schild/geo.
# Everything else is read-only or hidden.
#
# One unit for both setups. In place of a Caddy (ingress.caddyfile) schild
# binds ports 80 and 443 with CAP_NET_BIND_SERVICE, its only capability; as
# a proxy on port 8080 it does not use it. The certificates live in
# /var/lib/schild/caddy, a copy of Caddy's storage ("schild init -caddyfile"
# prints the copy commands), so no path of Caddy has to be writable here.
# The user schild must be able to read the Caddyfile and what it serves.
#
# A Caddyfile that writes log files: /var/log/caddy, Caddy's usual place, is
# writable below once the directory belongs to the user schild (sudo chown -R
# schild /var/log/caddy; the way back: chown -R caddy). "schild ingress
# validate", run as the user schild, tells when a log file is not writable.
#
# Your own changes belong in a drop-in (sudo systemctl edit schild), so an
# update of this file does not overwrite them. Log files in another
# directory need it there, e.g.
#   [Service]
#   ReadWritePaths=/var/log/my-sites
[Unit]
Description=Schild Gateway (reverse proxy with web application firewall)
Documentation=https://deutschland-schild.de/doku
Wants=network-online.target
After=network-online.target
ConditionPathExists=/etc/schild/schild.yaml

[Service]
Type=simple
User=schild
Group=schild
ExecStart=/usr/local/bin/schild run -config /etc/schild/schild.yaml
Restart=on-failure
RestartSec=5s
# A stop has to wait for the drain: in a cluster schild first leaves traffic
# for cluster.drain.delay_s (15 s), then running requests get
# cluster.drain.grace_s (30 s), then it shuts down. 90 s leaves room for that;
# raise it with those two values (in a drop-in). A single gateway stops sooner.
TimeoutStopSec=90s
LimitNOFILE=65536
UMask=0027

# --- files: only /var/lib/schild is writable, and /var/log/caddy if it exists ------
StateDirectory=schild
StateDirectoryMode=0750
# The log directory of a Caddyfile schild took over ("-": no error without it).
ReadWritePaths=-/var/log/caddy
WorkingDirectory=/var/lib/schild
Environment=SCHILD_DATA_DIR=/var/lib/schild
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes

# --- rights: none, except binding ports below 1024 (80 and 443 as the ingress) ----
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes

# --- kernel and system -------------------------------------------------------------
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target

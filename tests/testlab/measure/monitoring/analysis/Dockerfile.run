# TEST ONLY: MVP-21 measurement, local arm64 test image (not for production)
# The runtime of Dockerfile (spec21-measure:local) inline, so the base is pinned by digest.
FROM debian:trixie-slim@sha256:a72b4433de1cf7d6bae0c4cee74d0547f58601a643b3375f070c51600d63b6b2
RUN apt-get update && apt-get install -y --no-install-recommends iproute2 procps curl ca-certificates sysstat && rm -rf /var/lib/apt/lists/*
COPY schild-linux spec21-linux geo.mmdb Caddyfile Caddyfile-host schild-on.yaml schild-off.yaml schild-host.yaml /m/
RUN mkdir -p /m/data-on /m/data-off /m/data-host

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.schild.invalid/v0/audit-entry.schema.json",
  "title": "Audit entry (draft, MVP-36)",
  "description": "One entry of the audit log (audit.md). Stored on the gateway and, in a group, on every node; never sent to a lab or relay. Holds no password, token, key or other secret. Written once and never changed until audit.keep_days deletes it; the addresses in it stay that long.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "time", "node", "class", "action", "operation", "result", "actor", "subject"],
  "properties": {
    "schema": { "const": "schild.audit/0.1" },
    "id": { "$ref": "#/$defs/entryId" },
    "time": { "$ref": "common.schema.json#/$defs/timestamp" },
    "node": { "description": "The node that made the change: the CloudEvents source of its events without schild:// (cluster.md section 9).", "type": "string", "minLength": 1, "maxLength": 128 },
    "class": { "type": "string", "enum": ["change", "credential", "privacy", "access", "refused"] },
    "action": { "$ref": "#/$defs/action" },
    "operation": { "description": "What was called: <way>:<operation id, command or source>.", "type": "string", "maxLength": 96, "pattern": "^(dashboard|agent|integration|cli|config|system):[A-Za-z][A-Za-z0-9_ -]*$" },
    "result": { "type": "string", "enum": ["done", "refused"] },
    "actor": { "$ref": "#/$defs/actor" },
    "address": { "description": "Address the call came from, kept as long as the entry. Absent on the host.", "type": "string", "maxLength": 64 },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "type": "string", "pattern": "^[a-z][a-z_]{0,31}$" },
        "id": { "description": "Never an address: a block is named by its incident, a client by nothing.", "type": "string", "minLength": 1, "maxLength": 253 }
      }
    },
    "website": { "$ref": "#/$defs/website" },
    "change": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fields"],
      "properties": {
        "fields": { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/field" } },
        "more_fields": { "type": "integer", "minimum": 1, "maximum": 1000000 }
      }
    },
    "reason": { "description": "Untrusted text of the operator, an agent or a portal.", "type": "string", "minLength": 1, "maxLength": 500 },
    "count": { "description": "Refused calls gathered in this entry (one minute).", "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "last": { "$ref": "common.schema.json#/$defs/timestamp" }
  },
  "$defs": {
    "entryId": { "description": "<name of the log, 16 hex>-<k kept, a access, r refused>-<number, counted per log and letter from 1>.", "type": "string", "pattern": "^[0-9a-f]{16}-[kar]-[1-9][0-9]{0,15}$" },
    "action": { "type": "string", "maxLength": 64, "pattern": "^[a-z][a-z_]*\\.[a-z][a-z_]*$" },
    "website": { "type": "string", "minLength": 1, "maxLength": 253, "pattern": "^[a-z0-9_][a-z0-9_.-]*$" },
    "name": { "type": "string", "minLength": 1, "maxLength": 128 },
    "actor": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["kind"], "properties": { "kind": { "const": "dashboard" }, "user": { "$ref": "#/$defs/name" }, "session": { "$ref": "#/$defs/session" } } },
        { "type": "object", "additionalProperties": false, "required": ["kind"], "properties": { "kind": { "const": "agent" }, "id": { "type": "string", "pattern": "^tok_[0-9a-f]{12}$" }, "label": { "$ref": "#/$defs/label" } } },
        { "type": "object", "additionalProperties": false, "required": ["kind"], "properties": { "kind": { "const": "integration" }, "id": { "type": "string", "pattern": "^pk_[0-9a-f]{12}$" }, "label": { "$ref": "#/$defs/label" }, "session": { "$ref": "#/$defs/session" }, "on_behalf_of": { "description": "Who the portal says it acts for. Untrusted text.", "$ref": "#/$defs/name" } } },
        { "type": "object", "additionalProperties": false, "required": ["kind"], "properties": { "kind": { "const": "cli" }, "account": { "description": "Host account as the command saw it ($SUDO_USER, $USER); a hint, not a proof.", "$ref": "#/$defs/name" } } },
        { "type": "object", "additionalProperties": false, "required": ["kind"], "properties": { "kind": { "type": "string", "enum": ["config", "system"] } } }
      ]
    },
    "session": { "description": "Short id of a session, never its token.", "type": "string", "pattern": "^[0-9a-f]{8}$" },
    "label": { "type": "string", "minLength": 1, "maxLength": 64 },
    "pointer": { "type": "string", "maxLength": 512, "pattern": "^/" },
    "scalar": { "oneOf": [{ "type": "string", "maxLength": 512 }, { "type": "number" }, { "type": "boolean" }] },
    "items": { "type": "array", "maxItems": 32, "items": { "type": "string", "maxLength": 256 } },
    "field": {
      "description": "One changed field. Without before, after, added and removed, hidden says why.",
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "change"],
      "properties": {
        "field": { "$ref": "#/$defs/pointer" },
        "change": { "type": "string", "enum": ["added", "changed", "removed"] },
        "before": { "$ref": "#/$defs/scalar" },
        "after": { "$ref": "#/$defs/scalar" },
        "added": { "$ref": "#/$defs/items" },
        "removed": { "$ref": "#/$defs/items" },
        "more": { "description": "Items of the list left out.", "type": "integer", "minimum": 1, "maximum": 1000000 },
        "cut": { "description": "A value was longer than what is recorded; decided when the entry was written.", "const": true },
        "hidden": { "type": "string", "enum": ["secret", "unlisted", "list", "order", "size", "operator"] }
      }
    }
  }
}

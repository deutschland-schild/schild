{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.schild.invalid/v0/log-tree.schema.json",
  "title": "Public log with its signed head (contracts v0.1, cosign.md)",
  "description": "A copy of a lab's public log from index 0 together with the head {size, root} that the lab's checkpoint signs. The root is the RFC 6962 Merkle tree hash over the leaf data of every entry (cosign.md, section Public log tree). Used by golden vectors and by anyone who checks a log copy (lab dashboard, auditors).",
  "type": "object",
  "additionalProperties": false,
  "required": ["entries", "head"],
  "properties": {
    "entries": {
      "type": "array",
      "maxItems": 4096,
      "items": { "$ref": "#/$defs/entry" }
    },
    "head": {
      "type": "object",
      "additionalProperties": false,
      "required": ["size", "root"],
      "properties": {
        "size": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "root": { "$ref": "common.schema.json#/$defs/sha256" }
      }
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "time", "kind", "ref", "digest", "summary", "envelope_sha256"],
      "properties": {
        "index": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "time": { "$ref": "common.schema.json#/$defs/timestamp" },
        "kind": { "type": "string", "enum": ["proposal", "bundle", "withdrawal", "checkpoint"] },
        "ref": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{1,64}$" },
        "digest": { "$ref": "common.schema.json#/$defs/sha256" },
        "summary": { "description": "Printable ASCII, no line breaks: counts and ids only, never client data.", "type": "string", "pattern": "^[ -~]{0,280}$" },
        "envelope_sha256": {
          "description": "sha256 of the exact envelope bytes of bundle, withdrawal and checkpoint entries; null for proposal entries.",
          "oneOf": [{ "$ref": "common.schema.json#/$defs/sha256" }, { "type": "null" }]
        }
      }
    }
  }
}

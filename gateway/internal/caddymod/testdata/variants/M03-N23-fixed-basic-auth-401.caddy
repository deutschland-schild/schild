# unprotected: []
# expect: pass
# N23 after the advice: basic_auth 401 of a site without schild reaches a handle_errors with schild.
http://:18080 {
	import schild
	reverse_proxy 127.0.0.1:18081
	handle_errors {
		import schild
		reverse_proxy 127.0.0.1:18081
	}
}
http://b.example.test:18080 {
	basic_auth {
		admin $2a$14$Zkx19XLiW6VYouLHR5NmfOFU0z2GTNmpkT/5qqR7hx4IjWJPDhjvG
	}
	respond "ok"
}

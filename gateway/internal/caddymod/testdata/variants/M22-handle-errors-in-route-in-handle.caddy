# unprotected: []
# expect: refuse
# handle_errors proxy wrapped in route inside handle_errors, schild only under a path matcher.
http://:18080 {
	import schild
	reverse_proxy 127.0.0.1:18081
	handle_errors {
		route {
			schild /x*
			reverse_proxy 127.0.0.1:18081
		}
	}
}
http://b.example.test:18080 {
	error "boom" 500
}

# unprotected: []
# expect: refuse
# Operator-written route that hides the query from schild and restores the original URI in handle_errors (marker skips the second evaluation).
http://a.example.test:18080 {
	route {
		rewrite * /hidden?
		schild
		error "boom" 500
	}
	handle_errors {
		import schild
		rewrite * {http.request.orig_uri}
		reverse_proxy 127.0.0.1:18081
	}
}

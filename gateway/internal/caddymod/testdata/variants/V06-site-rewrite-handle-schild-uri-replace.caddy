# unprotected: []
# expect: refuse
# Site-level rewrite (directive order puts it before handle) and handle { schild; uri replace }.
http://a.example.test:26080 {
	vars saved {query}
	rewrite * /hidden?
	handle {
		schild
		uri replace /hidden /hidden?{vars.saved}
		reverse_proxy 127.0.0.1:26082
	}
}

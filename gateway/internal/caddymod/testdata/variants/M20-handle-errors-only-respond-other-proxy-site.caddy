# unprotected: []
# expect: pass
# handle_errors that only answers (no backend) next to a static site: must stay accepted.
http://:18080 {
	import schild
	reverse_proxy 127.0.0.1:18081
	handle_errors {
		respond "Fehler {err.status_code}" {err.status_code}
	}
}
http://b.example.test:18080 {
	root * /tmp/m19m3-empty
	file_server
}

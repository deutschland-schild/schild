# unprotected: []
# expect: refuse
# Fix round 2: a handle_errors proxy must run schild itself; the one-line fix is the A-* variant.
# Guarded site with header, root and request_body before schild (directive order) and handle_errors proxy.
http://a.example.test:18080 {
	import schild
	header X-Frame-Options DENY
	request_body {
		max_size 10MB
	}
	root * /srv
	reverse_proxy 127.0.0.1:18081
	handle_errors {
		reverse_proxy 127.0.0.1:18081
	}
}

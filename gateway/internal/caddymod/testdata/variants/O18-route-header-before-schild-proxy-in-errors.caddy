# unprotected: []
# expect: refuse
# Fix round 2: a handle_errors proxy must run schild itself; the one-line fix is the A-* variant.
# The use case's encode before schild in route form with handle_errors proxy.
http://a.example.test:18080 {
	route {
		encode zstd gzip
		import schild
		reverse_proxy 127.0.0.1:18081
	}
	handle_errors {
		reverse_proxy 127.0.0.1:18081
	}
}

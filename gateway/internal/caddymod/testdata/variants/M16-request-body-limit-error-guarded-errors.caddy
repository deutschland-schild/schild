# unprotected: []
# expect: pass
# request_body limit raises 413 when the backend reads the body; handle_errors runs schild.
http://a.example.test:18080 {
	import schild
	request_body {
		max_size 1KB
	}
	reverse_proxy 127.0.0.1:18081
	handle_errors {
		import schild
		reverse_proxy 127.0.0.1:18081
	}
}

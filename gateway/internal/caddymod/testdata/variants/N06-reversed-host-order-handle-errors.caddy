# unprotected: []
# expect: refuse
# Hosts listed in a different order in a path site (key mismatch), error before any schild.
http://a.example.test:18080, http://b.example.test:18080 {
	import schild
	reverse_proxy 127.0.0.1:18081
	handle_errors {
		reverse_proxy 127.0.0.1:18081
	}
}
http://b.example.test:18080/x/*, http://a.example.test:18080/x/* {
	error "boom" 500
}

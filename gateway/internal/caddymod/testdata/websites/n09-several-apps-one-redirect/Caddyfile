{
	admin off
}

http://a.example.org, http://www.a.example.org, http://b.example.org, http://c.example.org {
	redir https://{host}{uri} 308
}

a.example.org, www.a.example.org {
	schild
	reverse_proxy 127.0.0.1:19101
}

b.example.org {
	schild
	reverse_proxy 127.0.0.1:19102
}

c.example.org {
	schild
	root * /srv
	file_server
}

